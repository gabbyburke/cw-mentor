# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Datastore ID for curriculum materials (Analysis Function)
VERTEX_AI_DATASTORE_ID=projects/your-project/locations/global/collections/default_collection/dataStores/your-datastore-id

# Vertex RAG Corpus ID for mentorship materials (Mentorship Function)
VERTEX_RAG_CORPUS_ID=projects/your-project/locations/us-central1/ragCorpora/your-corpus-id

# Vertex RAG Corpus ID for simulation scenarios (Simulation Function)
VERTEX_RAG_CORPUS_ID_SCENARIOS=projects/your-project/locations/us-central1/ragCorpora/your-scenarios-corpus-id

# Optional: Enable debug streaming output (set to "true" to enable)
DEBUG_STREAMING=false
